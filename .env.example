# === Telegram Bot Configuration ===
# Получите токен у @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_TELEGRAM_IDS=123456789,987654321

# === Web Panel Security ===
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=admin_strong_password_here
SECRET_KEY=generate_a_random_secret_key_here_for_jwt

# === Web Server Settings ===
WEB_HOST=0.0.0.0
WEB_PORT=8080

# === AmneziaWG Configuration ===
# Каталог с конфигурационными файлами интерфейсов (.conf)
AWG_CONFIG_DIR=/etc/amnezia/amneziawg

# Внешний IP сервера (если пусто, определяется автоматически через ipify / ifconfig.me)
SERVER_PUBLIC_IP=

# DNS-сервер для клиентских конфигов (по умолчанию используется IP интерфейса сервера, где запущен AGH)
# Если оставить пустым, подставится IP сервера в интерфейсе (например, 10.12.0.1)
DEFAULT_DNS=

# Путь к базе данных SQLite
DATABASE_URL=sqlite+aiosqlite:///data/awg_manager.db
