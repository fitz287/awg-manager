[Unit]
Description=AmneziaWG All-in-One Manager (Web UI + Telegram Bot)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/awg-manager
ExecStart=/opt/awg-manager/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65535
EnvironmentFile=/opt/awg-manager/.env

[Install]
WantedBy=multi-user.target
